{
  "name": "parologames",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio de un solo autor para publicar juegos HTML5 jugables y descargables.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "setup-admin": "node --env-file-if-exists=.env scripts/setup-admin.js",
    "seed-demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js",
    "load-test": "node scripts/load-test.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "autocannon": "8.0.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
