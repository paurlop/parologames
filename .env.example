# .env.example — copia a .env y rellena. NUNCA subas .env al repositorio.
#   cp .env.example .env && chmod 600 .env
#
# En Docker (docker-compose.yml) NODE_ENV, PORT, GAMES_PORT, DATA_DIR, BACKUP_DIR y TRUST_PROXY
# se fijan en el propio compose y prevalecen sobre lo que pongas aquí.
# Las credenciales del propietario NO van aquí: `npm run setup-admin` las guarda hasheadas en la BD.

# ------------------------------------------------------------------ app (ARCHITECTURE.md)

# production en el servidor (cookies Secure, HSTS, trust proxy). development en local.
NODE_ENV=production

# Puerto del sitio y del origen de juegos (dentro del contenedor; no se publican en el host).
PORT=3000
GAMES_PORT=3001

# Orígenes públicos (esquema://host, sin ruta). Deben ser DISTINTOS.
# Lo ideal: el de juegos en otro dominio registrable (ver deploy/cloudflare.md).
SITE_ORIGIN=https://parologames.example
GAMES_ORIGIN=https://parolo-play.example

# Servicios externos que los juegos pueden usar (orígenes https separados por espacios).
# Vacío = ningún juego puede conectarse fuera. Palco de Honor usa Wikidata para los escudos reales;
# si lo dejas vacío, el juego dibuja escudos genéricos.
GAMES_CONNECT_SRC=https://www.wikidata.org
GAMES_IMG_SRC=https://commons.wikimedia.org https://upload.wikimedia.org

# Ruta del panel. Cámbiala por algo no adivinable (solo letras, números, _ y -).
ADMIN_PATH=/panel

# Directorio de datos (parolo.db, games/, covers/, downloads/, tmp/). En Docker: /var/lib/parolo/data.
DATA_DIR=./data

# Saltos de proxy de confianza. Con este compose: 1 (Caddy, que ya resuelve la IP real de Cloudflare).
TRUST_PROXY=1

# Duración máxima de la sesión del panel, en horas.
SESSION_TTL_HOURS=8

# Límites de subida en MB. Si los cambias, ajusta ADMIN_UPLOAD_MAX (suma de los tres + margen).
MAX_BUILD_MB=200
MAX_DOWNLOAD_MB=500
MAX_COVER_MB=5

# Sal para hashear IPs (no se guardan en claro). 32+ caracteres aleatorios. Vacía = la app no arranca en producción.
# Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# ------------------------------------------------------------------ app (opcionales; valores por defecto)
# LOG_LEVEL=info
# SESSION_IDLE_MINUTES=60
# RATE_GLOBAL_PER_MIN=300
# RATE_GAMES_PER_MIN=1500
# RATE_LOGIN_PER_15MIN=5
# RATE_DOWNLOAD_PER_10MIN=20
# RATE_UPLOAD_PER_HOUR=30
# LOGIN_LOCK_THRESHOLD=10
# LOGIN_LOCK_MINUTES=15
# CACHE_TTL_SECONDS=30

# ------------------------------------------------------------------ proxy (Caddy)

# Dominios (sin https://). Deben coincidir con SITE_ORIGIN y GAMES_ORIGIN.
SITE_DOMAIN=parologames.example
GAMES_DOMAIN=parolo-play.example

# Argumentos de la directiva `tls` de Caddy para SITE_DOMAIN:
#   Certificado de origen de Cloudflare (recomendado; ver deploy/cloudflare.md):
CADDY_TLS=/etc/caddy/certs/site.pem /etc/caddy/certs/site.key
#   o HTTPS automático con ACME (pon tu email):
# CADDY_TLS=tu-email@example.com
# Lo mismo para GAMES_DOMAIN. Necesario si es otro dominio registrable (otro certificado de origen).
# Si es un subdominio cubierto por el mismo certificado (*.parologames.com), déjalo comentado.
CADDY_TLS_GAMES=/etc/caddy/certs/games.pem /etc/caddy/certs/games.key

# IPs/CIDR (separados por espacios) que pueden abrir el panel. Al resto Caddy responde 404.
# Por defecto todo el mundo, para no dejarte fuera. Ejemplo: ADMIN_ALLOW_IPS=203.0.113.7/32 2001:db8:1234::/48
ADMIN_ALLOW_IPS=0.0.0.0/0 ::/0

# Tamaño máximo del cuerpo en las rutas de subida del panel (MAX_BUILD_MB + MAX_DOWNLOAD_MB + MAX_COVER_MB + margen).
ADMIN_UPLOAD_MAX=720MB

# ------------------------------------------------------------------ copias de seguridad

# Frase para cifrar las copias (AES-256-GCM). Mínimo 12 caracteres; mejor 5+ palabras al azar.
# Guárdala TAMBIÉN fuera del servidor (gestor de contraseñas): sin ella las copias no sirven.
# Vacía = copias sin cifrar (no recomendado si salen del servidor).
BACKUP_PASSPHRASE=

# Cuántas copias locales conservar.
BACKUP_KEEP=14

# Directorio de copias (en Docker: /var/lib/parolo/backups).
# BACKUP_DIR=./backups

# ------------------------------------------------------------------ imagen

# Etiqueta de la imagen a ejecutar (versión o git sha). Ver docs/DEPLOY.md → Actualizaciones.
APP_IMAGE=parologames
APP_TAG=latest
